# Application
APP_NAME=Dev Nest API
APP_VERSION=1.0.0
DEBUG=True

# Database (PostgreSQL inside Docker uses service name 'db')
DATABASE_URL=postgresql://example_user:example_password@db:5432/example_db

# PostgreSQL credentials (consumed by db service in docker-compose)
POSTGRES_DB=example_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password

# Security
SECRET_KEY=REPLACE_WITH_64_CHAR_MINIMUM_SECRET_KEY_SEE_COMMENT_ABOVE

# Session
SESSION_DEFAULT_DAYS=7
SESSION_REMEMBER_ME_DAYS=30

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Timezone (applied to Postgres session)
APP_TIMEZONE=Asia/Phnom_Penh

# Email — Brevo API
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@domain.com
BREVO_SENDER_NAME=Sender Name

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
