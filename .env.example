# Application
APP_NAME=FastAPI Authentication Boilerplate
APP_VERSION=1.0.0
DEBUG=True

# Database (PostgreSQL inside Docker uses service name 'db')
DATABASE_URL=postgresql://auth_boilerplate_user:auth_boilerplate_password@db:5432/auth_boilerplate_db

# PostgreSQL credentials (consumed by db service in docker-compose)
POSTGRES_DB=auth_boilerplate_db
POSTGRES_USER=auth_boilerplate_user
POSTGRES_PASSWORD=auth_boilerplate_password

# Security
# SECRET_KEY must be >= 64 characters (512 bits minimum for HS512).
# Generate with: docker compose run --rm api python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_64_CHAR_MINIMUM_SECRET_KEY_SEE_COMMENT_ABOVE
ALGORITHM=HS512
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Timezone (applied to Postgres session)
APP_TIMEZONE=Asia/Phnom_Penh

# Email — Brevo API
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@domain.com
BREVO_SENDER_NAME=Sender Name

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
